# openccu-lite: replaces /etc/init.d/S03CheckUserFSResize. The script runs unchanged; the
# cgroup keeps whatever it starts (KillMode=control-group), so stop and status are systemd's.
# The script unmounts and remounts /usr/local; every unit here orders itself with After= only,
# never Requires=/RequiresMountsFor=, so the mount going away briefly stops nothing. It runs with
# udev's event queue held (lite-userfs-hold): a probe of the partition while it is being
# rewritten would take /dev/disk/by-label/userfs away for a moment, and systemd would stop the
# userfs's check, usr-local.mount and every unit that requires the mount - occulited among them.
[Unit]
Description=Userfs resize
# S03 after S01 directly too: the LXC product drops occu-init-rtc (no hardware clock) and the chain
# must not split there (2026-09-09)
After=occu-init-rtc.service occu-init-host.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/libexec/occu/lite-psplash boot S03CheckUserFSResize
ExecStart=/usr/libexec/occu/lite-userfs-hold /etc/init.d/S03CheckUserFSResize.script start
ExecStartPost=-/usr/libexec/occu/lite-psplash done S03CheckUserFSResize
ExecStop=/etc/init.d/S03CheckUserFSResize.script stop
KillMode=control-group
# the journal names the script, as before the hold
SyslogIdentifier=S03CheckUserFSResize.script
UMask=0002
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
