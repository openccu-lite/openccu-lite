# openccu-lite: replaces /etc/init.d/S04CheckFactoryReset. The script runs unchanged; the
# cgroup keeps whatever it starts (KillMode=control-group), so stop and status are systemd's.
# On a fresh image (.doFactoryReset) the script unmounts /usr/local and makes a new file system on
# it: with udev's event queue held (lite-userfs-hold), or a probe between mkfs.ext4's wipe
# and its new superblock takes /dev/disk/by-label/userfs away for a moment, and systemd stops the
# userfs's check (BindsTo= the device), usr-local.mount and every unit that requires the mount -
# occu-clock-save failed and the pending starts of occulited-helper and occulited were dropped.
[Unit]
Description=Factory reset at boot
After=occu-userfs-resize.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/libexec/occu/lite-psplash boot S04CheckFactoryReset
ExecStart=/usr/libexec/occu/lite-userfs-hold /etc/init.d/S04CheckFactoryReset.script start
ExecStartPost=-/usr/libexec/occu/lite-psplash done S04CheckFactoryReset
ExecStop=/etc/init.d/S04CheckFactoryReset.script stop
KillMode=control-group
# the journal names the script, as before the hold
SyslogIdentifier=S04CheckFactoryReset.script
UMask=0002
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
