# openccu-lite (D-33): what tasks 17/18/20 need from the kernel on top of upstream's
# security.config (which already has seccomp, the LSM list and AppArmor): namespaces for
# per-addon confinement and for systemd's DynamicUser=/PrivateTmp=, cgroups for unit accounting.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
# the io controller and writeback attribution: occulited's per-service disk write accounting
# (System -> Services, System -> Storage) reads io.stat of the service cgroups; without
# CGROUP_WRITEBACK the page cache's writes are charged to the flusher, not to the service that
# dirtied the pages (needs MEMCG above). The defconfigs of all lite kernels have both today; pinned
# here so that a defconfig change cannot take them away. IOCOST/IOLATENCY/BFQ are not needed.
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
# overlayfs: the writable extension directories for addons (occu-extension-dirs.service) - the
# image's /firmware/rftypes as the lower layer, the addons' device descriptions in an upper layer
# on the userfs. Built in on every lite kernel: the x86_64 defconfig has no overlayfs at all, the
# Pi defconfigs a module that would have to be loaded first.
CONFIG_OVERLAY_FS=y
# openccu-lite task 86: NFS 4.1 and 4.2 for the backup targets on every product - one TCP connection
# to 2049 with the callback channel inside it, nothing inbound for the firewall to drop. The Pi
# defconfigs have them; the x86_64 one stops at 4.0.
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
# openccu-lite task 495: SCTP and XFS off. The Pi defconfigs build both as modules that nothing in
# openccu-lite loads (no SCTP user; USB storage is ext4 or exFAT, the Storage page formats nothing
# else), and the x86_64 defconfig builds neither - yet their CVEs counted for the Pi images
# (2.0.0-rc.3: CVE-2026-74752 in sctp, CVE-2026-99679 in xfs). Netfilter's SCTP conntrack is
# separate (NF_CT_PROTO_SCTP) and not touched.
# CONFIG_IP_SCTP is not set
# CONFIG_XFS_FS is not set
# openccu-lite task 508: a printk without a level is info, not warning. The kernel files such a line
# at MESSAGE_LOGLEVEL_DEFAULT, 4 by default; drivers like the Pi's dwc_otg print their whole init that
# way, so a healthy boot filled the journal's warnings. Lines with an explicit level (KERN_WARNING and
# worse) keep theirs. The console's level (CONSOLE_LOGLEVEL_DEFAULT, loglevel= on the command line)
# stays: the boot scripts pass loglevel=0, so neither 4 nor 6 reaches the console. The recovery's
# kernels keep upstream's 4: their fragments are upstream's, shared with upstream's products, and
# the recovery has no journal that sorts by level.
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=6
